# API settings
# Copy this file to .env and fill in the values.

# JWT — generate with: openssl rand -hex 32
API_JWT_SECRET=change-me

# JWT token lifetime in minutes
API_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin user bootstrapped at startup
# Generate hash with:
#   uv run python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD_HASH=change-me

# Docker Compose ports
API_PORT=8000
MLFLOW_PORT=5000
AIRFLOW_PORT=8080
STREAMLIT_PORT=8501

# API runtime mode
# true starts the API without loading real ML artifacts.
API_STUB_MODE=true

# Airflow local admin
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_WEBSERVER_SECRET_KEY=change-me

# Streamlit front-end
# Outside Docker the defaults point at localhost; docker-compose overrides them
# with the service names of the stack.
UI_API_URL=http://localhost:8000
UI_MLFLOW_URL=http://localhost:5000
UI_AIRFLOW_URL=http://localhost:8080

# Credentials pre-filled in the login forms (local demo convenience only)
UI_DEFAULT_USERNAME=admin
UI_DEFAULT_PASSWORD=changeme
UI_AIRFLOW_USERNAME=admin
UI_AIRFLOW_PASSWORD=admin
